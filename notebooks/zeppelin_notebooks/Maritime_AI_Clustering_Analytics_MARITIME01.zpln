    {
      "title": "3. Cluster Breakdown: Anomalies vs Normal Vessels",
      "text": "%jdbc(default)\n-- ============================================================================\n-- Anomaly Counts per Cluster\n-- Displays total fleet, normal vessels, and outlier count per cluster\n-- ============================================================================\nSELECT\n    'Cluster ' || cluster_id::text AS cluster_name,\n    COUNT(*) AS total_fleet,\n    SUM(CASE WHEN NOT is_anomaly THEN 1 ELSE 0 END) AS normal_vessels,\n    SUM(CASE WHEN is_anomaly THEN 1 ELSE 0 END) AS anomalous_vessels,\n    ROUND(100.0 * SUM(CASE WHEN is_anomaly THEN 1 ELSE 0 END) / COUNT(*), 2) AS anomaly_pct\nFROM vessel_behavior_clusters\nGROUP BY cluster_id\nORDER BY cluster_id;\n",
      "config": {
        "colWidth": 6.0,
        "fontSize": 9.0,
        "enabled": true,
        "results": {
          "0": {
            "graph": {
              "mode": "multiBarChart",
              "height": 300,
              "optionOpen": false,
              "keys": [
                {
                  "name": "cluster_name",
                  "index": 0,
                  "aggr": "sum"
                }
              ],
              "groups": [],
              "values": [
                {
                  "name": "normal_vessels",
                  "index": 2,
                  "aggr": "sum"
                },
                {
                  "name": "anomalous_vessels",
                  "index": 3,
                  "aggr": "sum"
                }
              ]
            }
          }
        },
