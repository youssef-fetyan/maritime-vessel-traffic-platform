    {
      "title": "2. Fleet Anomaly Distribution (Pie Chart)",
      "text": "%jdbc(default)\n-- ============================================================================\n-- Anomaly vs Normal Fleet Breakdown\n-- Renders out-of-the-box as an interactive Pie Chart in Zeppelin\n-- ============================================================================\nSELECT\n    CASE WHEN is_anomaly THEN 'Outlier / Anomaly (Distance > P95)'\n         ELSE 'Normal Navigation Profile'\n    END AS fleet_status,\n    COUNT(*) AS vessel_count\nFROM vessel_behavior_clusters\nGROUP BY is_anomaly\nORDER BY is_anomaly DESC;\n",
      "config": {
        "colWidth": 6.0,
        "fontSize": 9.0,
        "enabled": true,
        "results": {
          "0": {
            "graph": {
              "mode": "pieChart",
              "height": 300,
              "optionOpen": false,
              "keys": [
